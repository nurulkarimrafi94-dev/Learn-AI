AWS_ACCESS_KEY_ID = "your_aws_access_secret_key"
AWS_SECRET_ACCESS_KEY = "your_aws_secret_key"
AWS_REGION = us-east-1
S3_BUCKET=learn-ai-1

BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_HOST="learn-ai-index"
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

DATABASE_URL="your_postgres_database_url"

RIUS_API_KEY="your_rius_api_key"
RIUS_SERVICE_NAME=learn-ai-enterprise
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false